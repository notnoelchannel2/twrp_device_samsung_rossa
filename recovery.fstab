/boot            emmc              /dev/block/mmcblk0p16
/system          ext4              /dev/block/mmcblk0p24
/system_image    emmc              /dev/block/mmcblk0p24
/data	         ext4              /dev/block/mmcblk0p27
/cache	         ext4              /dev/block/mmcblk0p25
/misc	          emmc              /dev/block/platform/soc.0/by-name/misc
/recovery        emmc              /dev/block/mmcblk0p17   flags=backup=1
/efs1            emmc              /dev/block/mmcblk0p14   flags=backup=1;display=EFS
/efs2            emmc              /dev/block/mmcblk0p15   flags=backup=1;subpartitionof=/efs1

/external_sd     vfat              /dev/block/mmcblk1p1  /dev/block/mmcblk1
/usb-otg         vfat              /dev/block/sda1      /dev/block/sda              flags=removable;storage;display=USB-OTG
